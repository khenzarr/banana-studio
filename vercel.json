{
  "functions": {
    "api/image-job-worker.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "banana-image-jobs", "retryAfterSeconds": 60, "maxDeliveries": 10000 }]
    }
  },
  "crons": [{ "path": "/api/image-job-sweep", "schedule": "0 3 * * *" }],
  "headers": [
    {
      "source": "/share.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
